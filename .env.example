# Скопируйте этот файл в .env, если хотите что-то переопределить.
# Для локального запуска ничего заполнять НЕ обязательно — база данных
# это обычный файл (data/red-music.db), который создастся сам при первом старте.

# Секрет для подписи JWT-токенов авторизации. Смените на длинную случайную строку в проде!
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
NODE_ENV=development

# STORAGE_DIR — куда класть data/ (файл БД) и uploads/ (музыка).
# По умолчанию — папка проекта. На Render сюда указывают путь к Persistent Disk.
# STORAGE_DIR=/opt/render/project/src/storage
