#!/usr/bin/env bash
set -e

APP_HOME="$(cd "$(dirname "$0")" && pwd)"
GRADLE_VERSION="8.2.2"
CACHE_DIR="${HOME}/.gradle/red-music-wrapper/gradle-${GRADLE_VERSION}"
DIST_DIR="${CACHE_DIR}/gradle-${GRADLE_VERSION}"

if [ ! -x "${DIST_DIR}/bin/gradle" ]; then
  mkdir -p "${CACHE_DIR}"
  TMP_ZIP="${CACHE_DIR}/gradle-${GRADLE_VERSION}-bin.zip"

  if [ ! -f "$TMP_ZIP" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    curl --fail --location --silent --show-error \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
      -o "$TMP_ZIP"
  fi

  echo "Installing Gradle ${GRADLE_VERSION}..."
  rm -rf "${DIST_DIR}"
  unzip -q "$TMP_ZIP" -d "$CACHE_DIR"
fi

exec "${DIST_DIR}/bin/gradle" --project-dir "$APP_HOME" "$@"
