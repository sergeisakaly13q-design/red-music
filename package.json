{
  "name": "red-music-ready",
  "version": "4.4.0",
  "private": true,
  "description": "Red Music — shared server API, cross-device audio streaming, SQLite database and roles",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "desktop:build": "electron-builder --win --x64 --publish=never"
  },
  "dependencies": {
    "express": "^4.21.2",
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.7",
    "@capacitor/core": "^6.2.1",
    "@capacitor/android": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.redmusic.app",
    "productName": "Red Music",
    "artifactName": "Red-Music-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.cjs",
      "public/**/*",
      "resources/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Red-Music-${version}-portable.${ext}"
    }
  }
}
